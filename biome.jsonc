{
  "files": {
    "includes": [
      "src/**",
      "svelte.config.js",
      "tailwind.config.js",
      "vite.config.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "indentWidth": 4,
      "indentStyle": "space",
      "lineWidth": 120
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "style": {
        "useNamingConvention": {},
        "useTemplate": { "level": "off" }
      },
      "correctness": {
        "noUnusedImports": {},
        "noUnusedVariables": { "level": "off" }
      }
    }
  }
}
